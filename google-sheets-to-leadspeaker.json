      "parameters": {
        "jsCode": "// Log úspěšného přidání kontaktu\nconst contact = $input.all()[0].json;\n\nconsole.log('✅ Kontakt úspěšně přidán do Leadspeaker:', {\n  email: contact.email,\n  jméno: `${contact.firstName} ${contact.lastName}`,\n  timestamp: new Date().toISOString()\n});\n\nreturn { \n  success: true,\n  message: 'Kontakt úspěšně přidán do Leadspeaker',\n  contact: contact\n};"
